# Copy to /etc/cloudcart.env (chmod 600, owner root). Never commit real values.
DB_HOST=cloudcart-mysql.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=shopdb
DB_USER=cloudcart_app
DB_PASSWORD=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM
AWS_REGION=ap-south-1
# Only if the frontend uses a separate API hostname (CORS):
# FRONTEND_ORIGIN=https://shop.yourdomain.com
